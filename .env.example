# REQUIRED FOR SUPABASE-BACKED PERSISTENCE
# `npm run supabase:status` prints both values after the local stack starts.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required for league and user tracking
# Set both to enable user-scoped draft history and league-scoped board state.
# Sleeper's public API is read-only and does not require an API credential.
VITE_SLEEPER_LEAGUE_ID=
VITE_SLEEPER_USERNAME=

# OPTIONAL DRAFT-BOARD LAYOUT (defaults: 12 teams and slot 1)
VITE_DRAFT_LEAGUE_SIZE=12
VITE_DRAFT_SLOT=2

# OPTIONAL LOCAL COACH FUNCTION
# These values are server-only because they do not start with VITE_.
OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-5.6

# After editing this file, run `npm run env:validate` to see configuration
# errors and which optional features are enabled or disabled.
