# Local Supabase API. Run `npm run supabase:start`, then copy the anon key
# printed by `npm run supabase:status` into VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# The username is resolved to Sleeper's stable user ID at startup.
VITE_SLEEPER_LEAGUE_ID=
VITE_SLEEPER_USERNAME=

# Server-only secret for the local Supabase coach Edge Function. Never prefix
# this key with VITE_, which would expose it in the browser bundle.
OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-5.6
